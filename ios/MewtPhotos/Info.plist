<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key><string>en</string>
  <key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
  <key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
  <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
  <key>CFBundleName</key><string>MewtPhotos</string>
  <key>CFBundleDisplayName</key><string>Mewt Photos</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>$(MARKETING_VERSION)</string>
  <key>CFBundleVersion</key><string>$(CURRENT_PROJECT_VERSION)</string>
  <key>MewtPhotosGitSHA</key><string>$(GIT_SHA)</string>
  <key>LSRequiresIPhoneOS</key><true/>
  <key>UILaunchScreen</key><dict/>
  <key>UISupportedInterfaceOrientations</key>
  <array><string>UIInterfaceOrientationPortrait</string></array>
  <key>UIApplicationSceneManifest</key>
  <dict><key>UIApplicationSupportsMultipleScenes</key><false/></dict>
  <key>UIFileSharingEnabled</key><true/>
  <key>LSSupportsOpeningDocumentsInPlace</key><true/>
  <key>NSPhotoLibraryUsageDescription</key><string>Mewt Photos reads your photo library to back it up to your PC. It never changes or deletes anything.</string>
  <key>NSLocalNetworkUsageDescription</key><string>Mewt Photos connects to your PC on this Wi-Fi network.</string>
  <key>NSCameraUsageDescription</key><string>Used only to scan the pairing QR code shown on your PC.</string>
  <key>NSAppTransportSecurity</key>
  <dict><key>NSAllowsLocalNetworking</key><true/></dict>
  <key>UIBackgroundModes</key>
  <array><string>processing</string></array>
  <key>BGTaskSchedulerPermittedIdentifiers</key>
  <array><string>com.mewtcor.mewtphotos.autobackup</string></array>
</dict>
</plist>
