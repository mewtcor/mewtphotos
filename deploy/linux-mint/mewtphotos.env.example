# Copy to /etc/mewtphotos.env on the Mac mini (Linux Mint).
# Permissions: sudo chmod 640 /etc/mewtphotos.env && sudo chown root:mewtphotos /etc/mewtphotos.env

# Keeps the server running 24/7 even when no browser dashboard tab is open.
MEWTPHOTOS_DAEMON=1

# Listening port on 127.0.0.1 and MEWTPHOTOS_HOST.
MEWTPHOTOS_PORT=8787

# Mac mini static LAN IP.
MEWTPHOTOS_HOST=192.168.4.20

# Location of mewtphotos.db and server.log (outside the photo backup folder).
MEWTPHOTOS_DATA_DIR=/var/lib/mewtphotos

# Default backup folder used when initializing a fresh database (migrated DBs keep their migrated destination).
MEWTPHOTOS_BACKUP_DIR=/Media/iphonePhotosBackup
